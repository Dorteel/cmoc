{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDDL Domain",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "types", "predicates", "actions"],
  "properties": {
    "domain": {
      "type": "string"
    },

    "types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "predicates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/predicateDeclaration"
      }
    },

    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },

  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^\\?[A-Za-z][A-Za-z0-9_-]*$"
        },
        "type": {
          "type": "string"
        }
      }
    },

    "predicateDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parameters"],
      "properties": {
        "name": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        }
      }
    },

    "literal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "arguments"],
      "properties": {
        "predicate": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\?[A-Za-z][A-Za-z0-9_-]*$"
          }
        },
        "negated": {
          "type": "boolean",
          "default": false
        }
      }
    },

    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parameters",
        "preconditions",
        "effects"
      ],
      "properties": {
        "name": {
          "type": "string"
        },

        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },

        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/literal"
          }
        },

        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/literal"
          }
        }
      }
    }
  }
}