{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "search_result",
  "type": "object",
  "properties": {
    "Agent": {
      "type": "string"
    },
    "Theme": {
      "type": "string"
    },
    "Location": {
      "type": [
        "string",
        "null"
      ]
    },
    "Success": {
      "type": "boolean"
    },
    "observed_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "GazeAction": {
      "enum": [
        "look-at",
        "look-left",
        "look-right"
      ]
    }
  },
  "required": [
    "Agent",
    "Theme",
    "Location",
    "Success"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "GazeAction": {
            "enum": [
              "look-left",
              "look-right"
            ]
          }
        },
        "required": [
          "GazeAction"
        ]
      },
      "then": {
        "properties": {
          "Location": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "Location": {
            "type": "string"
          }
        }
      }
    }
  ]
}
