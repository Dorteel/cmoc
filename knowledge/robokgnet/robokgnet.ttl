fn:Bringing%2FFE%2FAgent a kg:FrameElement ;
    rdfs:label "Agent" ;
    dcterms:identifier 2117 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The Agent is a sentient being who physically controls the movement of the Theme via the carrier, accompanying the Theme. 'Karl carried the books across the campus to the library.'"@en .

fn:Bringing%2FFE%2FArea a kg:FrameElement ;
    rdfs:label "Area" ;
    dcterms:identifier 2123 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "Area is used for descriprion of a general area in which the carrying action takes place when the motion is understood to be irregular or not to consist of a single, linear path."@en .

fn:Bringing%2FFE%2FBeneficiary a kg:FrameElement ;
    rdfs:label "Beneficiary" ;
    dcterms:identifier 10246 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "This FE describes the particpant for whom the bringing is beneficial. "@en .

fn:Bringing%2FFE%2FCarrier a kg:FrameElement ;
    rdfs:label "Carrier" ;
    dcterms:identifier 4863 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The Carrier provides support for the Theme.  Movement of the Carrier results in movement of the Theme. 'The boat ferried the troops across the river.'"@en .

fn:Bringing%2FFE%2FCo-participant a kg:FrameElement ;
    rdfs:label "Co-participant" ;
    dcterms:identifier 10930 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "Co_participant is an entity that participates in a coordinated way in the same event as the primary protagonist, regardless of whether the protagonist, and hence the Co-participant, is more agent- or more undergoer-like."@en .

fn:Bringing%2FFE%2FConstant_location a kg:FrameElement ;
    rdfs:label "Constant_location" ;
    dcterms:identifier 2122 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The Constant_location expresses the location of the Theme relative to the Carrier.  This relationship holds for the entire length of the carrying event.  'Karl took the books to the library in his car.' 'Karl carried the books to the library in his arms.'"@en .

fn:Bringing%2FFE%2FDegree a kg:FrameElement ;
    rdfs:label "Degree" ;
    dcterms:identifier 10929 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "This frame element selects some gradable attribute and modifies the expected value for it."@en .

fn:Bringing%2FFE%2FDepictive a kg:FrameElement ;
    rdfs:label "Depictive" ;
    dcterms:identifier 2125 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "Depictive identifies a phrase describing the Carrier, Agent or Theme."@en .

fn:Bringing%2FFE%2FDistance a kg:FrameElement ;
    rdfs:label "Distance" ;
    dcterms:identifier 2126 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This FE identifies the Distance the Theme is carried."@en .

fn:Bringing%2FFE%2FDuration a kg:FrameElement ;
    rdfs:label "Duration" ;
    dcterms:identifier 10931 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "Duration denotes the length of time from the beginning of a continuous situation (the one denoted by the target) to its end. In many cases, the continuous situation is a dynamic action which is ongoing, while in others it is simply an undifferentiated state."@en .

fn:Bringing%2FFE%2FExplanation a kg:FrameElement ;
    rdfs:label "Explanation" ;
    dcterms:identifier 10186 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "Explanation denotes a proposition from which the main clause (headed by the target) logically follows. This often means that the Explanation causes the target's proposition, but not in all cases. "@en .

fn:Bringing%2FFE%2FFrequency a kg:FrameElement ;
    rdfs:label "Frequency" ;
    dcterms:identifier 10899 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "This frame element is used to indicate the location of a participant in cases where the multiple participants of an event are not co-located in the typical fashion. "@en .

fn:Bringing%2FFE%2FGoal a kg:FrameElement ;
    rdfs:label "Goal" ;
    dcterms:identifier 2118 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "Goal identifies the endpoint of the path.    'Karl carried the books to the library.'"@en .

fn:Bringing%2FFE%2FManner a kg:FrameElement ;
    rdfs:label "Manner" ;
    dcterms:identifier 2127 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This FE identifies the Manner  in which the Carrier or Agent carries the Theme ."@en .

fn:Bringing%2FFE%2FMeans a kg:FrameElement ;
    rdfs:label "Means" ;
    dcterms:identifier 4866 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The actions the Agent takes to move the Theme. 'The books were taken to the library by helicopter deliveries.' 'I haul books by putting them on top of my head.'"@en .

fn:Bringing%2FFE%2FParticular_iteration a kg:FrameElement ;
    rdfs:label "Particular_iteration" ;
    dcterms:identifier 10884 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "Expressions marked with this extra-thematic FE modify a non-iterative use of the target, and indicate that it is conceived as embedded within an iterated series of similar events or states."@en .

fn:Bringing%2FFE%2FPath a kg:FrameElement ;
    rdfs:label "Path" ;
    dcterms:identifier 2120 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "Path along which carrying occurs. 'Karl carried the books across the campus.' "@en .

fn:Bringing%2FFE%2FPeriod_of_iterations a kg:FrameElement ;
    rdfs:label "Period_of_iterations" ;
    dcterms:identifier 13038 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "This FE is minimally distinct from Duration and Duration_of final_state in that the clause described is conveyed to be iterative."@en .

fn:Bringing%2FFE%2FPlace a kg:FrameElement ;
    rdfs:label "Place" ;
    dcterms:identifier 5453 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The Place is the general area that serves as a setting for the specific motion of the Agent and Theme (with Source, Path, or Goal).   'Even in such a small port, these boats would transport many tons of trade-goods in to shore annually.'"@en .

fn:Bringing%2FFE%2FPurpose a kg:FrameElement ;
    rdfs:label "Purpose" ;
    dcterms:identifier 4850 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The Purpose for which the Carrier or Agent carries the Theme . 'We had to carry the heavy weights all the way to the top of the hillto show our strength.'"@en .

fn:Bringing%2FFE%2FSource a kg:FrameElement ;
    rdfs:label "Source" ;
    dcterms:identifier 2119 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "Source indicates the beginning of the path along which the Theme travels.    'Karl hauled the books from the library  to the office.' "@en .

fn:Bringing%2FFE%2FSpeed a kg:FrameElement ;
    rdfs:label "Speed" ;
    dcterms:identifier 4625 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The Speed is the rate at which the carrying or transporting occurs."@en .

fn:Bringing%2FFE%2FTheme a kg:FrameElement ;
    rdfs:label "Theme" ;
    dcterms:identifier 2121 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The objects being carried. 'Karl toted the books to the car.' "@en .

fn:Bringing%2FFE%2FTime a kg:FrameElement ;
    rdfs:label "Time" ;
    dcterms:identifier 5454 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The time in which the carrying event takes place."@en .

fn:Criminal_investigation a kg:Frame ;
    rdfs:label "Criminal_investigation" ;
    dcterms:identifier 500 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:definition "This frame describes the process that involves the inquiry and determination by an authority, the Investigator, of the circumstances surrounding an Incident perpetrated by a Suspect.  'The police are investigating the bank's reported loss of several thousand dollars from their downtown branch's top security vault. DNI ' 'Authorities are investigating several murders. DNI'"@en ;
    kg:hasFrameElement fn:Criminal_investigation%2FFE%2FDuration,
        fn:Criminal_investigation%2FFE%2FIncident,
        fn:Criminal_investigation%2FFE%2FInvestigator,
        fn:Criminal_investigation%2FFE%2FSuspect,
        fn:Criminal_investigation%2FFE%2FTime ;
    kg:lexicalUnit fn:LU%2F18702,
        fn:LU%2F7958,
        fn:LU%2F7959,
        fn:LU%2F7963,
        fn:LU%2F7965,
        fn:LU%2F7966,
        fn:LU%2F8046,
        fn:LU%2F8402,
        fn:LU%2F8403 .

fn:Criminal_investigation%2FFE%2FDuration a kg:FrameElement ;
    rdfs:label "Duration" ;
    dcterms:identifier 4096 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "The length of the investigation. 'The police carried out a two-year investigation into terrorist kidnappings.'"@en .

fn:Criminal_investigation%2FFE%2FIncident a kg:FrameElement ;
    rdfs:label "Incident" ;
    dcterms:identifier 4045 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The Investigator attempts to determine the exact circumstances surrounding the Incident, which is typically a criminal act (murder, robbery) or the result of such an act (death, loss of money)."@en .

fn:Criminal_investigation%2FFE%2FInvestigator a kg:FrameElement ;
    rdfs:label "Investigator" ;
    dcterms:identifier 4041 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The Investigator is the person or agency that investigates the Suspect of a crime (Incident)."@en .

fn:Criminal_investigation%2FFE%2FSuspect a kg:FrameElement ;
    rdfs:label "Suspect" ;
    dcterms:identifier 4693 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "This FE denotes the Suspect that is investigated by the Investigator. 'The police are investigating Dr. Phil.'"@en .

fn:Criminal_investigation%2FFE%2FTime a kg:FrameElement ;
    rdfs:label "Time" ;
    dcterms:identifier 4075 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "When the Investigator investigates the Incident. 'Our guys are currently investigating her disappearance.'"@en .

