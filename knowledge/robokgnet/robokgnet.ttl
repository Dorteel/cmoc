wn:automaton.n.02 a owl:Class ;
    rdfs:label "automaton.n.02" ;
    dcterms:description "a mechanism that can move automatically"@en ;
    dcterms:identifier "automaton.n.02" ;
    rdfs:subClassOf wn:mechanism.n.05 ;
    skos:altLabel "automaton"@en,
        "golem"@en,
        "robot"@en ;
    prov:wasDerivedFrom source:WordNet .

wn:person.n.01 a owl:Class ;
    rdfs:label "person.n.01" ;
    dcterms:description "a human being"@en ;
    dcterms:identifier "person.n.01" ;
    rdfs:subClassOf wn:causal_agent.n.01,
        wn:organism.n.01 ;
    skos:altLabel "individual"@en,
        "mortal"@en,
        "person"@en,
        "somebody"@en,
        "someone"@en,
        "soul"@en ;
    prov:wasDerivedFrom source:WordNet .

<https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl#move> a prov:Entity ;
    rdfs:label "move" ;
    dcterms:description """action move(robot - object r, location from, location to) {
    preconditions = [
      robot_at(r, from)
    ]
    effects = [
      robot_at(r, from) := false
      robot_at(r, to) := true
    ]
  }""" ;
    prov:wasDerivedFrom <https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl> ;
    kg:planningKind "PlanningAction" .

<https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl#pick> a prov:Entity ;
    rdfs:label "pick" ;
    dcterms:description """action pick(robot - object r, object o, location l) {
    preconditions = [
      (known(o) and robot_at(r, l) and at(o, l) and hand_empty(r))
    ]
    effects = [
      holding(r, o) := true
      at(o, l) := false
      hand_empty(r) := false
    ]
  }""" ;
    prov:wasDerivedFrom <https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl> ;
    kg:planningKind "PlanningAction" .

<https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl#place> a prov:Entity ;
    rdfs:label "place" ;
    dcterms:description """action place(robot - object r, object o, location l) {
    preconditions = [
      (robot_at(r, l) and holding(r, o))
    ]
    effects = [
      at(o, l) := true
      hand_empty(r) := true
      holding(r, o) := false
    ]
  }""" ;
    prov:wasDerivedFrom <https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl> ;
    kg:planningKind "PlanningAction" .

<https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl#predicate%2Fat> a prov:Entity ;
    rdfs:label "at" ;
    dcterms:description "bool at[o=object, l=location]" ;
    prov:wasDerivedFrom <https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl> ;
    kg:planningKind "PlanningPredicate" .

<https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl#predicate%2Fhand_empty> a prov:Entity ;
    rdfs:label "hand_empty" ;
    dcterms:description "bool hand_empty[r=robot - object]" ;
    prov:wasDerivedFrom <https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl> ;
    kg:planningKind "PlanningPredicate" .

<https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl#predicate%2Fholding> a prov:Entity ;
    rdfs:label "holding" ;
    dcterms:description "bool holding[r=robot - object, o=object]" ;
    prov:wasDerivedFrom <https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl> ;
    kg:planningKind "PlanningPredicate" .

<https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl#predicate%2Fknown> a prov:Entity ;
    rdfs:label "known" ;
    dcterms:description "bool known[o=object]" ;
    prov:wasDerivedFrom <https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl> ;
    kg:planningKind "PlanningPredicate" .

<https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl#predicate%2Frobot_at> a prov:Entity ;
    rdfs:label "robot_at" ;
    dcterms:description "bool robot_at[r=robot - object, l=location]" ;
    prov:wasDerivedFrom <https://example.org/cmoc/procedural_memory/planning/bringing/test/domain.pddl> ;
    kg:planningKind "PlanningPredicate" .

<https://example.org/cmoc/procedural_memory/planning/bringing/test/problem.pddl#goal> a prov:Entity ;
    rdfs:label "Conjunctive goals" ;
    dcterms:description "at(theme, destination)" ;
    prov:wasDerivedFrom <https://example.org/cmoc/procedural_memory/planning/bringing/test/problem.pddl> ;
    kg:planningKind "GoalState" .

<https://example.org/cmoc/procedural_memory/planning/bringing/test/problem.pddl#initial> a prov:Entity ;
    rdfs:label "Parsed initial state (including UP defaults)" ;
    dcterms:description "at(agent, destination) = false",
        "at(agent, robot_start_location) = false",
        "at(agent, source) = false",
        "at(theme, destination) = false",
        "at(theme, robot_start_location) = false",
        "at(theme, source) = true",
        "hand_empty(agent) = true",
        "holding(agent, agent) = false",
        "holding(agent, theme) = false",
        "known(agent) = false",
        "known(theme) = false",
        "robot_at(agent, destination) = false",
        "robot_at(agent, robot_start_location) = true",
        "robot_at(agent, source) = false" ;
    prov:wasDerivedFrom <https://example.org/cmoc/procedural_memory/planning/bringing/test/problem.pddl> ;
    kg:planningKind "InitialState" .

