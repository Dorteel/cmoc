        fn:LU%2F9285 .

fn:Path_shape%2FFE%2FArea a kg:FrameElement ;
    rdfs:label "Area" ;
    dcterms:identifier 272 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "This frame element is used for expressions which describe a general area in which motion takes place when the motion is understood to be irregular and not to consist of a single linear path.    'The paths crisscrossed the desert.'  Note that this FE should not be used for any locational modifier which would occur just as naturally with a non-motion predicate, like speech.  "@en .

fn:Path_shape%2FFE%2FDegree a kg:FrameElement ;
    rdfs:label "Degree" ;
    dcterms:identifier 1910 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "Extent to which the described configuration deviates from the norm for a Road.  'The road bent slightly before resuming its long, straight march to the sea .' "@en .

fn:Path_shape%2FFE%2FDepictive a kg:FrameElement ;
    rdfs:label "Depictive" ;
    dcterms:identifier 1920 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "Depictive phrase describing the character of the Road.  'The trail snaked down the mountainside, arduous and nearly impassable.'  "@en .

fn:Path_shape%2FFE%2FDirection a kg:FrameElement ;
    rdfs:label "Direction" ;
    dcterms:identifier 7230 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The direction in which a \"fictive\" mover would travel along a Road.  'The pass dips down about 2000 feet, and then back up again.'"@en .

fn:Path_shape%2FFE%2FDistance a kg:FrameElement ;
    rdfs:label "Distance" ;
    dcterms:identifier 271 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "Any expression which characterizes the extent of motion expresses the frame element Distance.   'The thin line of dirt and gravel wound another ten miles and on into the Ozarks before it petered out completely.'"@en .

fn:Path_shape%2FFE%2FGoal a kg:FrameElement ;
    rdfs:label "Goal" ;
    dcterms:identifier 268 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "Any expression which tells where the fictive mover travelling along a Road would end up.   'Where does Interstate 80 enter the city ?'"@en .

fn:Path_shape%2FFE%2FManner a kg:FrameElement ;
    rdfs:label "Manner" ;
    dcterms:identifier 270 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "Any expression which describes a property of motion which is not directly related to the trajectory of motion expresses the frame element Manner. Descriptions of the kind of motion a hypothetical mover would have (including steadiness, grace, and general comparisons) count as Manner expressions.    'Drifting clouds lent a mystical touch while the narrow road twisted crazily through ancient stone villages on the valley floor.'"@en .

fn:Path_shape%2FFE%2FMeans a kg:FrameElement ;
    rdfs:label "Means" ;
    dcterms:identifier 1913 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "An state of affairs involving the Road that allows the Road to be in the specified configuration.  'As the Condell Road the route skirts the northside of Limerick by passing through Westfield's bird sanctuary on the north bank of the River Shannon.'"@en .

fn:Path_shape%2FFE%2FPath a kg:FrameElement ;
    rdfs:label "Path" ;
    dcterms:identifier 267 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The trajectory that would be followed by one moving on the Road.  'Valencia angles across the number streets.'"@en .

fn:Path_shape%2FFE%2FPath_shape a kg:FrameElement ;
    rdfs:label "Path_shape" ;
    dcterms:identifier 4970 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The configuration formed by the entire Path along the Road. 'The cavern descended in a spiral.'"@en .

fn:Path_shape%2FFE%2FPlace a kg:FrameElement ;
    rdfs:label "Place" ;
    dcterms:identifier 4861 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The Place is where the motion (which is specified by a Source, Path or Goal) is located.  'In the mountains, Highway 60 winds and swerves a lot, so we lost a couple of hours from my estimate.'"@en .

fn:Path_shape%2FFE%2FPurpose a kg:FrameElement ;
    rdfs:label "Purpose" ;
    dcterms:identifier 7299 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "The state-of-affairs that the Road brings about by being in a particular configuration.  'The roadwound around in order to circumvent the house..'"@en .

fn:Path_shape%2FFE%2FResult a kg:FrameElement ;
    rdfs:label "Result" ;
    dcterms:identifier 1916 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "Result of an event"@en .

fn:Path_shape%2FFE%2FRoad a kg:FrameElement ;
    rdfs:label "Road" ;
    dcterms:identifier 269 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "A physical path that a virtual moving entity can be imagined to travel along. The bike trail zigzagged through the woods. "@en .

fn:Path_shape%2FFE%2FSource a kg:FrameElement ;
    rdfs:label "Source" ;
    dcterms:identifier 266 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "Any expression which implies a definite starting-point of the Road. In prepositional phrases, the prepositional object expresses the starting point of motion. In particles, the starting point of motion is understood from context.   'The Way descends from the City of the Peak through a dense forest.'"@en .

fn:Path_shape%2FFE%2FSpeed a kg:FrameElement ;
    rdfs:label "Speed" ;
    dcterms:identifier 1917 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The Speed is the rate at which an imaginary traveler on the Road would move.  'The road quickly drops after passing the final turn.'"@en .

fn:Path_shape%2FFE%2FTime a kg:FrameElement ;
    rdfs:label "Time" ;
    dcterms:identifier 7240 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The time when the fictive motion takes place.  This may describe the time when the Road or a particular piece of the Road existed, or it may implicitly describe the time when an actual motion event occurred on the Road.  'Thousands of years ago, the Roman roads criss-crossed this landscape.' 'After it reached the edge of the forest, the road slanted upwards and grew rough.'"@en .

fn:Scouring a kg:Frame ;
    rdfs:label "Scouring" ;
    dcterms:identifier 1263 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:definition "A Searcher looks all over a Ground in order to find a Sought_entity. The Sought_entity is not presupposed to exist. The search activity is not concerned with the state of the Ground, which is the case in the Inspecting frame, but only with the finding of the Sought_entity, which is desirable.   'The newcomers combed the area looking for minerals' 'Scientists scoured the ice samples  for signs of life. ' 'Mulder rummaged through his toilet kit for a plastic razor.'"@en ;
    kg:hasFrameElement fn:Scouring%2FFE%2FDegree,
        fn:Scouring%2FFE%2FDuration,
        fn:Scouring%2FFE%2FGround,
        fn:Scouring%2FFE%2FInstrument,
        fn:Scouring%2FFE%2FManner,
        fn:Scouring%2FFE%2FMeans,
        fn:Scouring%2FFE%2FPurpose,
        fn:Scouring%2FFE%2FSearcher,
        fn:Scouring%2FFE%2FSought_entity,
        fn:Scouring%2FFE%2FTime ;
    kg:lexicalUnit fn:LU%2F11278,
        fn:LU%2F11279,
        fn:LU%2F11280,
        fn:LU%2F11281,
        fn:LU%2F11282,
        fn:LU%2F11283,
        fn:LU%2F11284,
        fn:LU%2F15668 .

fn:Scouring%2FFE%2FDegree a kg:FrameElement ;
    rdfs:label "Degree" ;
    dcterms:identifier 9630 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This FE identifies the Degree to which the Searcher scrutinizes the Ground."@en .

fn:Scouring%2FFE%2FDuration a kg:FrameElement ;
    rdfs:label "Duration" ;
    dcterms:identifier 7295 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This FE specifies the length of the interval during which the scouring activtiy takes place.  'He combed the area for hours that night looking for the dogs and has been searching ever since.' "@en .

fn:Scouring%2FFE%2FGround a kg:FrameElement ;
    rdfs:label "Ground" ;
    dcterms:identifier 7292 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The location that the Searcher covers in looking for the Sought_entity.  'I had never really seen much on the bigfoot subject or I would have scoured the area for signs and looked for droppings'"@en .

fn:Scouring%2FFE%2FInstrument a kg:FrameElement ;
    rdfs:label "Instrument" ;
    dcterms:identifier 9631 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "An entity manipulated by the Searcher to examine the Ground.  'They scoured the entire beach with a metal detector, but found nothing.'"@en .

fn:Scouring%2FFE%2FManner a kg:FrameElement ;
    rdfs:label "Manner" ;
    dcterms:identifier 7294 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This FE identifies the Manner in which the Searcher scrutinizes the Ground.  'We carefully scoured the road for what damaged all of those tires and we finally found it- a piece of nasty, barbed wire, laying across the road.'"@en .

fn:Scouring%2FFE%2FMeans a kg:FrameElement ;
    rdfs:label "Means" ;
    dcterms:identifier 9632 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The action of the Searcher that allows them to search the Ground."@en .

fn:Scouring%2FFE%2FPurpose a kg:FrameElement ;
    rdfs:label "Purpose" ;
    dcterms:identifier 9633 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The state-of-affairs that the Searcher hopes to bring about by searching a Ground.  'We scoured the entire book to find this supposed evidence.'"@en .

fn:Scouring%2FFE%2FSearcher a kg:FrameElement ;
    rdfs:label "Searcher" ;
    dcterms:identifier 7291 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The person who is looking all over the Ground for the Sought_entity.  'They first gained entry into the house of Raja Rao, who resides on the ground floor and ransacked the house for valuables.'"@en .

fn:Scouring%2FFE%2FSought_entity a kg:FrameElement ;
    rdfs:label "Sought_entity" ;
    dcterms:identifier 7293 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The entity that the Searcher wants to find.  'Coast Guard and Navy ships and aircraft combed the area for the six aircraft'"@en .

fn:Scouring%2FFE%2FTime a kg:FrameElement ;
    rdfs:label "Time" ;
    dcterms:identifier 11989 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The Time when the Searcher scoures the Ground. "@en .

fn:Scrutiny%2FFE%2FCognizer a kg:FrameElement ;
    rdfs:label "Cognizer" ;
    dcterms:identifier 128 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The Cognizer pays attention to an entity in order to discover something about it. The FE is normally expressed as an External Argument:  'Leslie examined the glass for cracks.'"@en .

fn:Scrutiny%2FFE%2FDegree a kg:FrameElement ;
    rdfs:label "Degree" ;
    dcterms:identifier 1500 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "This FE identifies the Degree to which the Cognizer scrutinizes the Ground."@en .

fn:Scrutiny%2FFE%2FDirection a kg:FrameElement ;
    rdfs:label "Direction" ;
    dcterms:identifier 2335 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "Direction is used for all path-like expressions, except those indicating the location of the perceiver, that describe how the perceiver's attention is directed during the act of perception.  'The detective looked across the street at the suspect.'"@en .

fn:Scrutiny%2FFE%2FGround a kg:FrameElement ;
    rdfs:label "Ground" ;
    dcterms:identifier 129 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The Cognizer pays attention to the Ground, so named because it serves as the background or context for the Phenomenon. This FE can be expressed as an NP Object or as a PP Complement. 'Leslie examined the glass for cracks.' 'Kim searched the woods for mushrooms.'"@en .

fn:Scrutiny%2FFE%2FInstrument a kg:FrameElement ;
    rdfs:label "Instrument" ;
    dcterms:identifier 9143 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "An entity directed by the Cognizer  that interacts with the Ground to accomplish the scrutiny.  'The temperature controller monitored the temperature with a calibrated silicon diode.'"@en .

fn:Scrutiny%2FFE%2FManner a kg:FrameElement ;
    rdfs:label "Manner" ;
    dcterms:identifier 1497 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This FE identifies the Manner in which the Cognizer scrutinizes the Ground."@en .

fn:Scrutiny%2FFE%2FMeans a kg:FrameElement ;
    rdfs:label "Means" ;
    dcterms:identifier 1498 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This FE is used for the Means by which the Cognizer to scrutinize the Ground. 'We analysed the sediment by putting it through the mass spec.'"@en .

fn:Scrutiny%2FFE%2FMedium a kg:FrameElement ;
    rdfs:label "Medium" ;
    dcterms:identifier 7030 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The Medium is the piece of text or work in which the Cognizer pays attention to an entity in order to discover something about it. The FE is normally expressed as an External Argument:  'Chapter four examined the case for free speech.'"@en .

fn:Scrutiny%2FFE%2FPhenomenon a kg:FrameElement ;
    rdfs:label "Phenomenon" ;
    dcterms:identifier 130 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "Phenomenon identifies the property that belongs to an entity or that the entity contains. Typically, it is expressed as a for-PP. 'Leslie examined the glass for cracks.' 'Kim searched the woods for mushrooms.' "@en .

fn:Scrutiny%2FFE%2FPurpose a kg:FrameElement ;
    rdfs:label "Purpose" ;
    dcterms:identifier 4511 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "Some of the words in this frame occur with a constituent that expresses the desired outcome of the Scrutiny.  Normally this constituent is a PP Complement headed by for or a to-marked VP Complement.  'You should inspect your mail to determine the outcome of the module transfer.'"@en .

fn:Scrutiny%2FFE%2FTime a kg:FrameElement ;
    rdfs:label "Time" ;
    dcterms:identifier 11990 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The Time when the Cognizer is scrutinizing the Ground. "@en .

fn:Searching_scenario%2FFE%2FCognizer a kg:FrameElement ;
    rdfs:label "Cognizer" ;
    dcterms:identifier 9644 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The Cognizer pays attention to the Ground in order to find instances of a type of Phenomenon.  'Leslie examined the glass for cracks.'"@en .

fn:Searching_scenario%2FFE%2FDegree a kg:FrameElement ;
    rdfs:label "Degree" ;
    dcterms:identifier 9649 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This FE identifies the Degree to which the Cognizer scrutinizes the Ground."@en .

fn:Searching_scenario%2FFE%2FGround a kg:FrameElement ;
    rdfs:label "Ground" ;
    dcterms:identifier 9645 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The Cognizer pays attention to the Ground, so named because it serves as the background or context for the Phenomenon.   'Leslie examined the glass for cracks.' 'Kim searched the woods for mushrooms.'"@en .

fn:Searching_scenario%2FFE%2FInstrument a kg:FrameElement ;
    rdfs:label "Instrument" ;
    dcterms:identifier 9651 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "An entity directed by the Cognizer  that interacts with the Ground to accomplish the scrutiny.  'The temperature controller monitored the temperature with a calibrated silicon diode.'"@en .

fn:Searching_scenario%2FFE%2FManner a kg:FrameElement ;
    rdfs:label "Manner" ;
    dcterms:identifier 9647 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This FE identifies the Manner in which the Cognizer scrutinizes the Ground."@en .

fn:Searching_scenario%2FFE%2FMeans a kg:FrameElement ;
    rdfs:label "Means" ;
    dcterms:identifier 9648 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The action of the Cognizer which allows them to scrutinize the Ground. "@en .

fn:Searching_scenario%2FFE%2FPhenomenon a kg:FrameElement ;
    rdfs:label "Phenomenon" ;
    dcterms:identifier 9646 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The entity that the Cognizer is alert for in the Ground.  'Leslie examined the glass for cracks.' 'Kim searched the woods for mushrooms.' "@en .

fn:Searching_scenario%2FFE%2FPurpose a kg:FrameElement ;
    rdfs:label "Purpose" ;
    dcterms:identifier 9650 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The event that the Cognizer hopes to bring about by looking for the Phenomenon.  'You should inspect your mail to determine the outcome of the module transfer.'"@en .

fn:Seeking a kg:Frame ;
    rdfs:label "Seeking" ;
    dcterms:identifier 269 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:definition "A Cognizer_agent attempts to find some Sought_entity by examining some Ground.  The success or failure of this activity (the Outcome) may be indicated.  NB:  This frame should be compared to the Scrutiny frame, in which the primary focus is on the Ground.  'John looked for his pencil.'"@en ;
    kg:hasFrameElement fn:Seeking%2FFE%2FCognizer_agent,
        fn:Seeking%2FFE%2FDegree,
        fn:Seeking%2FFE%2FGround,
        fn:Seeking%2FFE%2FManner,
        fn:Seeking%2FFE%2FMeans,
        fn:Seeking%2FFE%2FOutcome,
        fn:Seeking%2FFE%2FPlace,
        fn:Seeking%2FFE%2FPurpose,
        fn:Seeking%2FFE%2FSought_entity,
        fn:Seeking%2FFE%2FTime ;
    kg:lexicalUnit fn:LU%2F17046,
        fn:LU%2F17682,
        fn:LU%2F4898,
        fn:LU%2F4899,
        fn:LU%2F4900,
        fn:LU%2F4902,
        fn:LU%2F4903,
        fn:LU%2F4904,
        fn:LU%2F4905,
        fn:LU%2F4906,
        fn:LU%2F4907,
        fn:LU%2F4912,
        fn:LU%2F4913,
        fn:LU%2F4915,
        fn:LU%2F4917 .

fn:Seeking%2FFE%2FCognizer_agent a kg:FrameElement ;
    rdfs:label "Cognizer_agent" ;
    dcterms:identifier 2327 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The person who attempts to find the Sought_entity. 'John  looked for his pencil.'"@en .

fn:Seeking%2FFE%2FDegree a kg:FrameElement ;
    rdfs:label "Degree" ;
    dcterms:identifier 12108 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This FE identifies the amount of effort put into an attempt."@en .

fn:Seeking%2FFE%2FGround a kg:FrameElement ;
    rdfs:label "Ground" ;
    dcterms:identifier 2328 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This is the entity to which the Cognizer_agent pays attention. It is referred to as Ground because it serves as the background or context for the Sought_entity. This FE can be expressed as an NP Object (first example) or as a PP Complement (second example).  'Leslie examined the glass for cracks.'  'Kim searched in the woods for mushrooms.'"@en .

fn:Seeking%2FFE%2FManner a kg:FrameElement ;
    rdfs:label "Manner" ;
    dcterms:identifier 2330 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The Manner of performing an action."@en .

fn:Seeking%2FFE%2FMeans a kg:FrameElement ;
    rdfs:label "Means" ;
    dcterms:identifier 2332 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "An act of the Cognizer_agent that allows them to look for the Sought_entity. 'They foraged for clams by visiting the pools at low tide.'"@en .

fn:Seeking%2FFE%2FOutcome a kg:FrameElement ;
    rdfs:label "Outcome" ;
    dcterms:identifier 2334 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The failure or success of an attempt."@en .

fn:Seeking%2FFE%2FPlace a kg:FrameElement ;
    rdfs:label "Place" ;
    dcterms:identifier 5402 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "A spatial setting larger than the Ground in which the Seeking event occurs.  'In Paris police were hunting for suspects in two of the city's southerns suburbs today'"@en .

fn:Seeking%2FFE%2FPurpose a kg:FrameElement ;
    rdfs:label "Purpose" ;
    dcterms:identifier 5404 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "An action that the Cognizer_agent intends to accomplish by performing the search.  'Police were hunting for evidence in my house to mislead their real suspect about the state of the investigation'"@en .

fn:Seeking%2FFE%2FSought_entity a kg:FrameElement ;
    rdfs:label "Sought_entity" ;
    dcterms:identifier 2329 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "This is the entity that the Ground may contain. Typically, it is expressed as a for-PP.   'Leslie examined the glass for cracks.'  'Kim searched in the woods for mushrooms.'  Some words in this frame allow alternate expressions of the Ground and the Sought_entity.  'We searched the yard for my contact lens.'   'We searched for my contact lens in the yard.' "@en .

fn:Seeking%2FFE%2FTime a kg:FrameElement ;
    rdfs:label "Time" ;
    dcterms:identifier 5403 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This FE identifies the Time when the Seeking occurs.  'The police were hunting for evidence in my house yesterday'"@en .

fn:Shopping a kg:Frame ;
    rdfs:label "Shopping" ;
    dcterms:identifier 1882 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:definition "A Shopper looks for Goods in order to purchase them.  'She shopped for a new hat.'"@en ;
    kg:hasFrameElement fn:Shopping%2FFE%2FCo-participant,
        fn:Shopping%2FFE%2FDegree,
        fn:Shopping%2FFE%2FDepictive,
        fn:Shopping%2FFE%2FGoods,
        fn:Shopping%2FFE%2FGround,
        fn:Shopping%2FFE%2FManner,
        fn:Shopping%2FFE%2FMeans,
        fn:Shopping%2FFE%2FOutcome,
        fn:Shopping%2FFE%2FPlace,
        fn:Shopping%2FFE%2FPurpose,
        fn:Shopping%2FFE%2FShopper,
        fn:Shopping%2FFE%2FTime ;
    kg:lexicalUnit fn:LU%2F13921,
        fn:LU%2F13925 .

fn:Shopping%2FFE%2FCo-participant a kg:FrameElement ;
    rdfs:label "Co-participant" ;
    dcterms:identifier 13851 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "The Co-participant is an entity that participates in a coordinated way in the shopping event with the Shopper."@en .

fn:Shopping%2FFE%2FDegree a kg:FrameElement ;
    rdfs:label "Degree" ;
    dcterms:identifier 12109 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This FE identifies the amount of effort put into shopping."@en .

fn:Shopping%2FFE%2FDepictive a kg:FrameElement ;
    rdfs:label "Depictive" ;
    dcterms:identifier 13850 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Extra-Thematic" ;
    kg:definition "This FE describes a participant of shopping scenario as being in some state during the action."@en .

fn:Shopping%2FFE%2FGoods a kg:FrameElement ;
    rdfs:label "Goods" ;
    dcterms:identifier 11140 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "This is the entity that the Ground may contain. Typically, it is expressed as afor-PP."@en .

fn:Shopping%2FFE%2FGround a kg:FrameElement ;
    rdfs:label "Ground" ;
    dcterms:identifier 11139 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This is the entity to which the Cognizer pays attention. It is referred to as the Ground because it serves as the background or context for the Goods. This FE is usually expressed as a preposition phrase."@en .

fn:Shopping%2FFE%2FManner a kg:FrameElement ;
    rdfs:label "Manner" ;
    dcterms:identifier 11141 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The Manner in which the shopping action is done."@en .

fn:Shopping%2FFE%2FMeans a kg:FrameElement ;
    rdfs:label "Means" ;
    dcterms:identifier 11142 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "An act of the Shopper that allows them to look for (and perhaps purchase) the Goods.  'They shopped for hot items by camping out overnight at shopping malls.'"@en .

fn:Shopping%2FFE%2FOutcome a kg:FrameElement ;
    rdfs:label "Outcome" ;
    dcterms:identifier 11144 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "The failure or success of an attempt."@en .

fn:Shopping%2FFE%2FPlace a kg:FrameElement ;
    rdfs:label "Place" ;
    dcterms:identifier 11145 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "A spatial setting larger than the Ground in which the Shopping event occurs."@en .

fn:Shopping%2FFE%2FPurpose a kg:FrameElement ;
    rdfs:label "Purpose" ;
    dcterms:identifier 11147 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "An action that the Shopper intends to accomplish by performing the search."@en .

fn:Shopping%2FFE%2FShopper a kg:FrameElement ;
    rdfs:label "Shopper" ;
    dcterms:identifier 11138 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Core" ;
    kg:definition "The person who attempts to find the Goods. 'John shopped for a pencil.'"@en .

fn:Shopping%2FFE%2FTime a kg:FrameElement ;
    rdfs:label "Time" ;
    dcterms:identifier 11146 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:coreType "Peripheral" ;
    kg:definition "This FE identifies the time when the shopping occurs.  'The children were shopping for gifts for their parents before Christmas.'"@en .

