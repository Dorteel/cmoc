fn:Path_shape a kg:Frame ;
    rdfs:label "Path_shape" ;
    dcterms:identifier 61 ;
    prov:wasDerivedFrom source:FrameNet ;
    kg:definition "The words in this frame describe the \"fictive\" motion of a stationary Road.  Some of the targets cast the scene primarily in terms of the Path_shape:  'The long mountain road meandered through the woods.'  Some of the words in this frame imply a Source or Goal which is expressed by a direct object:  'The path entered the garden on the west side.'  Other members of the frame refer to a Direction: 'Then the path bears a little to the right.'  Yet others indicate a Path which requires mention of a landmark:  'The otherwise arrow-straight highway veers north and skirts the lake.'"@en ;
    kg:hasFrameElement fn:Path_shape%2FFE%2FArea,
        fn:Path_shape%2FFE%2FDegree,
        fn:Path_shape%2FFE%2FDepictive,
        fn:Path_shape%2FFE%2FDirection,
        fn:Path_shape%2FFE%2FDistance,
        fn:Path_shape%2FFE%2FGoal,
        fn:Path_shape%2FFE%2FManner,
        fn:Path_shape%2FFE%2FMeans,
        fn:Path_shape%2FFE%2FPath,
        fn:Path_shape%2FFE%2FPath_shape,
        fn:Path_shape%2FFE%2FPlace,
        fn:Path_shape%2FFE%2FPurpose,
        fn:Path_shape%2FFE%2FResult,
        fn:Path_shape%2FFE%2FRoad,
        fn:Path_shape%2FFE%2FSource,
        fn:Path_shape%2FFE%2FSpeed,
        fn:Path_shape%2FFE%2FTime ;
    kg:lexicalUnit fn:LU%2F1054,
        fn:LU%2F1055,
        fn:LU%2F1056,
        fn:LU%2F1057,
        fn:LU%2F1058,
        fn:LU%2F1059,
        fn:LU%2F1060,
        fn:LU%2F1061,
        fn:LU%2F1062,
        fn:LU%2F1063,
        fn:LU%2F1064,
        fn:LU%2F1065,
        fn:LU%2F1068,
        fn:LU%2F1069,
        fn:LU%2F1070,
        fn:LU%2F1071,
        fn:LU%2F1072,
        fn:LU%2F1073,
        fn:LU%2F1074,
        fn:LU%2F1075,
        fn:LU%2F1076,
        fn:LU%2F1077,
        fn:LU%2F1078,
        fn:LU%2F1079,
        fn:LU%2F10920,
        fn:LU%2F11971,
        fn:LU%2F13087,
        fn:LU%2F17740,
        fn:LU%2F5034,
        fn:LU%2F5036,
        fn:LU%2F5037,
        fn:LU%2F5038,
        fn:LU%2F5040,
        fn:LU%2F5050,
        fn:LU%2F5051,
        fn:LU%2F5052,
        fn:LU%2F5053,
        fn:LU%2F5054,
        fn:LU%2F5055,
